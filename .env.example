# =============================================================================
# CTFacile — Environment Variables
# Copy this file to .env and fill in the values before running docker-compose.
# NEVER commit .env to version control.
# =============================================================================

# --- Django Core ---
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-real-secret-key
DEBUG=0

# Comma-separated list of allowed hostnames (no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,ctfacile.local

# --- PostgreSQL ---
POSTGRES_USER=ctfacile
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=ctfacile_db

# --- CTF Routing ---
# The LAN or public IP of the host machine.
# Used to build nip.io subdomains: teamX-challY.<CTF_HOST_IP>.nip.io
# For local dev: 127.0.0.1
# For LAN classroom: e.g. 192.168.1.100
# For cloud: your server's public IPv4
CTF_HOST_IP=127.0.0.1

# The primary domain the Django app is served under.
# Traefik routes requests for this domain to the web service.
CTF_DOMAIN=ctfacile.local

# --- Docker / Traefik ---
# Must match DEFAULT_TRAEFIK_NETWORK in core/constants.py
TRAEFIK_NETWORK_NAME=ctfacile_traefik_public
